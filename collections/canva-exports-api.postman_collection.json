      "name": "Exports",
      "description": {
        "content": "Export designs to PDF, PNG, JPG, GIF, PPTX, and MP4",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "57073bdb-efa3-4331-8916-80923e0a561f",
          "name": "Canva Create a Design Export Job",
          "request": {
            "name": "Canva Create a Design Export Job",
            "description": {
              "content": "Creates an asynchronous job to export a design from Canva. Supported formats include PDF, JPG, PNG, GIF, PPTX, and MP4. Each format supports format-specific options such as quality, dimensions, page selection, and transparency.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "exports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "design:meta:read design:content:read design:content:write asset:read asset:write folder:read folder:write comment:read comment:write brandtemplate:meta:read brandtemplate:content:read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.canva.com/rest/v1/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://www.canva.com/api/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"design_id\": \"<string>\",\n  \"format\": {\n    \"type\": \"<string>\",\n    \"export_quality\": \"regular\",\n    \"size\": \"a4\",\n    \"pages\": [\n      \"<integer>\",\n      \"<integer>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
