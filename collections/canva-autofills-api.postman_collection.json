                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand_template_id\": \"<string>\",\n  \"data\": {\n    \"key_0\": {\n      \"type\": \"<string>\",\n      \"text\": \"<string>\"\n    },\n    \"key_1\": {\n      \"type\": \"<string>\",\n      \"text\": \"<string>\"\n    }\n  },\n  \"title\": \"<string>\"\n}",
