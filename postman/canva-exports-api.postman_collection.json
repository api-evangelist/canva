            "body": {
              "mode": "raw",
              "raw": "{\n  \"design_id\": \"<string>\",\n  \"format\": {\n    \"type\": \"pdf\",\n    \"export_quality\": \"regular\",\n    \"size\": \"a4\",\n    \"pages\": [\n      \"<integer>\",\n      \"<integer>\"\n    ]\n  }\n}",
